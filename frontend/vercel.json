{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://govguide-backend-uc7w.onrender.com/api/:path*"
    },
    {
      "source": "/ai-service/:path*",
      "destination": "https://govguide-ai-8sk1.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

