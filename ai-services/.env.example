# ==========================================
# GovGuide AI Services - Environment Config
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# CORS Settings (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Qdrant Vector Database
# Option A: Local in-memory / local folder mode (leave QDRANT_URL empty to use local storage)
# Option B: Docker container (e.g., http://localhost:6333)
# Option C: Qdrant Cloud cluster
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=govguide_schemes
QDRANT_STORAGE_PATH=./qdrant_storage

# Ingestion Security
# Secret key required in X-Ingest-Key header for POST /api/v1/ingest/schemes
INGEST_API_KEY=your_ingest_secret_key_here

# MongoDB Connection (for ingesting verified schemes directly)
MONGODB_URI=mongodb://127.0.0.1:27017/govguide

